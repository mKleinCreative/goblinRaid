# Goblin Siege — repo root ignores
#
# NOTE: .gitignore does not untrack files already in the index. The
# *_Backup_* directories were committed before this file existed and remain
# tracked; they need `git rm --cached` to remove (still outstanding — it is
# Michael's call, since untracking them removes them for anyone else on the
# branch while leaving his local rollback copies intact).
# The __pycache__ half of that debt was cleared in #115.
# These rules stop NEW ones from entering.

# Editor-side map/asset backups. Large binary .umap/.uasset copies of content
# that is already versioned — Map_Backup_20260806 alone is 177 MB.
*_Backup_*/

# Python bytecode
__pycache__/
*.pyc

# UBT console transcripts from the scratch build wrappers, and gs_step.py, the
# scratch buffer gs_run.ps1 executes (it is whatever you last wanted to run in
# the editor, so its contents are never worth versioning).
#
# ROOT-ANCHORED ON PURPOSE. A bare `*.log` would also bury
# content-pipeline/out/**/run.log and coding-agent/run*.log, which are
# deliberately-kept pipeline run records — content-pipeline/.gitignore says
# outright "out/ is deliberately NOT ignored", and ticket 052 cites one as
# evidence.
/*.log
/gs_step.py

# Windows artefact of a `> /dev/null` redirect — never a real directory here.
# The four git-lfs hooks that landed in it were byte-identical to .git/hooks/*
# and git never ran them (core.hooksPath is unset).
dev/null/

# Local secrets. The pipeline's loader also reads ./.env and
# "GoblinSiege 5.8/.env"; the latter is ignored by that project's own
# .gitignore. Never commit an API key.
.env
.env.*

# Blender's rolling auto-backup. Every save of a .blend in ArtSource/ drops a
# .blend1 beside it, so these arrive in pairs with files we DO version and are
# pure noise in `git status`. The .blend itself stays tracked.
#
# Arrived from the other side of the merge conflict this file sat in; kept
# because it is an independent rule, not an alternative to anything above.
*.blend1

# Cygwin/MSYS grep crash dumps. Pure noise; one already slipped into the index.
*.stackdump
